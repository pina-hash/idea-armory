<Project Sdk="Microsoft.NET.Sdk">
  <!-- net10.0-windows only so the vault test double can call Armory.Platform.Windows.VaultIgnore,
       the platform layer's own ignore list. The assembly runs on Linux like the platform tests. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <ProjectReference Include="../../src/Armory.Agent.Engine/Armory.Agent.Engine.csproj" />
    <ProjectReference Include="../../src/Armory.Platform.Windows/Armory.Platform.Windows.csproj" />
    <ProjectReference Include="../Armory.TestSupport/Armory.TestSupport.csproj" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../GuardTests/DocumentedTestGuard.cs" Link="DocumentedTestGuard.cs" />
    <!-- Synthetic SolidWorks containers built in code (never a CAD file). -->
    <Compile Include="../Armory.Core.Tests/SwContainer.cs" Link="SwContainer.cs" />
    <None Include="../GUARDS.txt" Link="GUARDS.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
