<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The same Windows version as src/Armory.Agent, which a plain net10.0-windows project
         cannot reference. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The tests touch no Windows Forms type, and Linux has no Windows Desktop runtime. Keeping
         the agent's Windows Forms framework reference from flowing in lets the
         platform-neutral tests (contract, redaction, settings) run on Linux too. -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" PrivateAssets="all" />
    <ProjectReference Include="../../src/Armory.Agent/Armory.Agent.csproj" />
    <!-- The real host on a shared computer (ProfilesHostTests): the fake Supabase and site over a
         throwaway PostgreSQL database, and the end-to-end tests' portable folder and stores. The
         fakes run on ASP.NET Core, which the disabled transitive references above would leave out. -->
    <ProjectReference Include="../Armory.TestSupport/Armory.TestSupport.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Armory.EndToEnd.Tests/PortableVaultFileSystem.cs" Link="Portable/PortableVaultFileSystem.cs" />
    <Compile Include="../Armory.EndToEnd.Tests/MemoryStores.cs" Link="Portable/MemoryStores.cs" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../GuardTests/DocumentedTestGuard.cs" Link="DocumentedTestGuard.cs" />
    <None Include="../GUARDS.txt" Link="GUARDS.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Same as src/Armory.Agent: the WebView2 package's WPF control is not used. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>
</Project>
